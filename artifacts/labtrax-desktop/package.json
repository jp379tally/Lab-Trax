{
  "name": "@workspace/labtrax-desktop",
  "version": "1.0.6",
  "description": "LabTrax Desktop — Dental Lab Operations",
  "author": "LabTrax",
  "private": true,
  "type": "module",
  "packageManager": "[email protected]",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\" \"electron/**/*.{ts,tsx}\"",
    "test": "vitest run && pnpm run test:timing-sensitive && pnpm run test:register-browser && pnpm run test:tooth-chart-browser",
    "test:timing-sensitive": "cross-env DESKTOP_TIMING_SENSITIVE_REPEATS=2 vitest run --reporter=verbose src/pages/finance/__tests__/register-keyboard-nav.test.tsx src/pages/__tests__/statements-payment-refresh.test.tsx",
    "test:register-browser": "node scripts/register-long-browser-test.mjs && node scripts/case-drawer-narrow-browser-test.mjs && pnpm run test:statements-cutoff-browser",
    "test:tooth-chart-browser": "node scripts/tooth-chart-browser-test.mjs",
    "test:statements-cutoff-browser": "node scripts/statements-cutoff-browser-test.mjs",
    "test:provider-browser": "node scripts/provider-startup-browser-test.mjs",
    "test:dashboard-reference-browser": "node scripts/dashboard-reference-browser-test.mjs",
    "electron:dev": "concurrently \"vite --config vite.electron.config.ts\" \"cross-env ELECTRON_DEV=1 ELECTRON_DEV_PORT=5173 electron .\"",
    "electron:build": "node scripts/electron-build.mjs",
    "electron:store-package": "node scripts/package-windows-store.mjs",
    "electron:store-package:validate": "node scripts/validate-windows-store-package.mjs",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "electron:backup-smoke": "node scripts/backup-download-packaged-smoke.mjs",
    "electron:backup-installer-smoke": "node scripts/backup-download-packaged-smoke.mjs --installer"
  },
