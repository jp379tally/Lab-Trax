# Node modules — EAS installs these on its build servers
node_modules/
.pnpm-store/

# Git history
.git

# Build outputs
dist/
build/
static-build/
server_dist/
.expo/
*.tsbuildinfo

# Desktop app — not needed for mobile build (Electron binaries are huge)
artifacts/labtrax-desktop/

# API server artifact — not needed for mobile build
artifacts/api-server/

# Mockup sandbox — not needed for mobile build
artifacts/mockup-sandbox/

# Large assets — explicit paths in case EAS archives from workspace root
attached_assets/
artifacts/labtrax/attached_assets/

# Workspace-only tooling, documentation, and local recovery data
.github/
.production-api/
.production-runtime/
docs/
e2e/
playwright-report/
screenshots/
support/
uploads/
*.md
*.sql
*.dump
*.dump.*
*.enc

# Binaries and archives
*.exe
*.zip
*.tar.gz
*.tar.xz
*.dmg
*.pkg

# Logs and temp files
*.log
logs/
tmp/
.local/

# LabTrax web/server output and local source-download bundles
artifacts/labtrax/server/
artifacts/labtrax/public/downloads/
artifacts/labtrax/public/labtrax-full-source.txt
artifacts/labtrax/public/labtrax-source.tar.gz

# Mobile tests and development-only tooling. Keep modules/labtrax-depth/Tests:
# eas-build-post-install runs those Swift regression tests on iOS builds.
artifacts/labtrax/**/__tests__/
artifacts/labtrax/__tests__/
artifacts/labtrax/**/*.test.*
artifacts/labtrax/**/*.spec.*
artifacts/labtrax/vitest.config.ts
artifacts/labtrax/vitest.setup.ts
artifacts/labtrax/test-stubs/
artifacts/labtrax/maestro/
artifacts/labtrax/scripts/web-bundle-smoke.js
artifacts/labtrax/scripts/test-write-asc-key.py
artifacts/labtrax/.replit-artifact/

# When this file is used from the app directory, the app is the ignore root.
app/__tests__/
components/**/__tests__/
lib/**/__tests__/
__tests__/
*.test.*
*.spec.*
vitest.config.ts
vitest.setup.ts
test-stubs/
maestro/
server/
public/downloads/
public/labtrax-full-source.txt
public/labtrax-source.tar.gz
.replit-artifact/
