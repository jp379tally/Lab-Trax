{
  "name": "@workspace/labtrax",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "CI=1 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=${REPLIT_DEV_DOMAIN:?REPLIT_DEV_DOMAIN is required for the Expo development preview} EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:hex": "node scripts/lint-hex-colors.mjs",
    "test:build-web-export": "node --test scripts/build-web-export.test.js",
    "test:web-bundle": "pnpm run test:build-web-export && node scripts/web-bundle-smoke.js",
    "test:case-header-browser": "LABTRAX_WEB_SMOKE_CASE_HEADER_ONLY=1 node scripts/web-bundle-smoke.js",
    "test": "vitest run",
    "test:ios-depth": "swift test --package-path modules/labtrax-depth",
    "eas-build-post-install": "bash scripts/eas-build-post-install.sh"
  },
