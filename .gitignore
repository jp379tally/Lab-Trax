# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp/
/tmp/
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
AuthKey_*.p8

# Build / output directories — never commit build artifacts
static-build/
/.production-api/
/.production-runtime/
**/static-build/
**/electron-dist/
**/build/
**/out/
**/.turbo/
**/.next/
/playwright-report/
/test-results/

# Server runtime data — uploaded case media is per-deployment, not source
artifacts/api-server/uploads/

# Migration / backup snapshots — these are throwaway working copies
.migration-backup/

# Database dumps — never commit these. A production dump carries the lab's
# live records (users, cases, invoices, payments); keep it in restricted
# storage and reference it from a text note instead.
*.dump
*.dump.sha256
support/prod-export-*/
support/prod-restored-*/
# Row-level orphan reports list real records, for the same reason.
support/owning-organization-orphans/*.csv

# Archives, installers, and other large binaries
*.tar.gz
*.tar.gz.part
*.tgz
*.zip
*.dmg
*.exe
*.msi
*.pkg
*.AppImage
*.ipa

# Large media uploads — keep on disk if needed, but never commit
*.mp4
*.mov

# Static export output (Expo / Vite)
**/static-build/
exports/

# Logs
*.log

# Patient-identifying operator reports are private runtime artifacts, never source.
/attached_assets/*labtrax-backup*.enc
/attached_assets/image_1791832841904.png
/attached_assets/image_1791833262991.png
/generated-artifacts/
/.private-operator-reports/
/support/rebuild-lost-cases-2026-10-06/created-at-repair-report.json
